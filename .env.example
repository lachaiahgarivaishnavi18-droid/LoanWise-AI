DATABASE_URL=sqlite:///./runtime/loanwise.db
DEMO_MODE=true
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://127.0.0.1:5173
STORAGE_DIR=runtime/documents
MODEL_DIR=runtime/models
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
RETRIEVAL_MODE=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SESSION_HOURS=8
RETENTION_DAYS=90
RISK_LOW_THRESHOLD=0.3
RISK_HIGH_THRESHOLD=0.6
OCR_ENABLED=true
OCR_MAX_PAGES=20
OCR_MAX_PIXELS=20000000
PARSER_TIMEOUT_SECONDS=60
PARSER_MEMORY_MB=2048

# JSON jurisdiction allowlists; unconfigured jurisdictions abstain from model inference.
MODEL_FEATURE_POLICIES={"SYNTHETIC DEMO":["dti","lti","employment_months","credit_utilization","missed_payments"]}

# Serverless uploads persist originals in PostgreSQL when set to database.
DOCUMENT_STORAGE=filesystem
PARSER_PROCESS_MODE=spawn
